<!DOCTYPE html>
<html lang="ha">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>VFootball H2H</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f4f7;
      margin: 0;
      padding: 20px;
    }

    .container {
      max-width: 700px;
      margin: auto;
      background: white;
      padding: 20px;
      border-radius: 15px;
      box-shadow: 0 3px 15px rgba(0,0,0,0.1);
    }

    h1 {
      text-align: center;
      margin-bottom: 20px;
    }

    input {
      width: 100%;
      box-sizing: border-box;
      padding: 13px;
      margin: 7px 0;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
      border: none;
      border-radius: 8px;
      background: #087f5b;
      color: white;
      font-size: 17px;
      font-weight: bold;
    }

    .section {
      margin-top: 20px;
      padding: 15px;
      background: #f8f9fa;
      border-radius: 10px;
    }

    .match {
      padding: 10px;
      margin: 7px 0;
      background: white;
      border-radius: 7px;
      border: 1px solid #ddd;
    }

    .result {
      font-weight: bold;
    }

    .note {
      color: #666;
      font-size: 14px;
      text-align: center;
      margin-top: 15px;
    }
  </style>
</head>

<body>

<div class="container">

  <h1>⚽ VFootball H2H</h1>

  <input id="team1" type="text" placeholder="Team 1 misali: VIL">
  <input id="team2" type="text" placeholder="Team 2 misali: ELC">

  <button onclick="searchH2H()">🔎 Search H2H</button>

  <div class="section">
    <h2>H2H</h2>
    <div id="h2h">Shigar da kungiyoyi sannan ka danna Search.</div>
  </div>

  <div class="section">
    <h2>Last 5 Matches</h2>
    <div id="last5">Babu bayanai tukuna.</div>
  </div>

  <div class="section">
    <h2>Last 10 Matches</h2>
    <div id="last10">Babu bayanai tukuna.</div>
  </div>

  <div class="section">
    <h2>Statistics</h2>
    <div id="stats">Babu bayanai tukuna.</div>
  </div>

  <p class="note">
    VFootball H2H System — Prototype
  </p>

</div>

<script>

function searchH2H() {

  let team1 = document.getElementById("team1").value.trim();
  let team2 = document.getElementById("team2").value.trim();

  if (team1 === "" || team2 === "") {
    alert("Da fatan za ka rubuta Team 1 da Team 2.");
    return;
  }

  team1 = team1.toUpperCase();
  team2 = team2.toUpperCase();

  document.getElementById("h2h").innerHTML = `
    <div class="match">
      ${team1} 🆚 ${team2}
    </div>
    <div class="match">H2H data: Ana jiran haɗa real data source.</div>
  `;

  document.getElementById("last5").innerHTML = `
    <div class="match">Last 5 na ${team1} — ana jiran data</div>
    <div class="match">Last 5 na ${team2} — ana jiran data</div>
  `;

  document.getElementById("last10").innerHTML = `
    <div class="match">Last 10 na ${team1} — ana jiran data</div>
    <div class="match">Last 10 na ${team2} — ana jiran data</div>
  `;

  document.getElementById("stats").innerHTML = `
    <div class="match">Over 1.5: —</div>
    <div class="match">Over 2.5: —</div>
    <div class="match">BTTS / GG: —</div>
    <div class="match">Win / Draw / Loss: —</div>
  `;
}

</script>

</body>
</html>